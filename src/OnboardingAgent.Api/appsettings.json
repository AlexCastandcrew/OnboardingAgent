{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Bedrock": {
    "Region": "us-east-1",
    "AnswerModelId": "us.anthropic.claude-sonnet-5-5",
    "AuxModelId": "us.anthropic.claude-haiku-5-5",
    "TimeoutSeconds": 30,
    "MaxRetries": 2,
    "AnswerMaxTokens": 2500,
    "AuxMaxTokens": 600,
    "DisableAuxThinking": true
  },
  "Corpus": {
    "Folder": "../../corpus",
    "ManifestFile": "manifest.json",
    "DataFolder": "../../data",
    "StateFolder": "../../.data",
    "IngestOnStartup": true,
    "ChunkTargetChars": 2000,
    "ChunkOverlapChars": 320,
    "ExcludedPatterns": [ ".env*", "appsettings*", "*.config", "CLAUDE.md", "CLAUDE.local.md", "*secret*", "*credential*", "*.pem", "*.key" ]
  },
  "Chat": {
    "MaxMessageChars": 2000,
    "MaxHistoryItems": 6,
    "MaxHistoryItemChars": 2000,
    "CandidateCount": 20,
    "ContextChunks": 6,
    "MaxChunksPerDocument": 4,
    "MinScore": 0,
    "InitiativeBoost": 1.5,
    "DomainBoost": 1.25,
    "RequestTimeoutSeconds": 45
  },
  "RateLimiting": {
    "Chat": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
